# {{ ansible_managed }}
# /etc/haproxy/haproxy.cfg

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    maxconn {{ haproxy_tcp_lb_maxconn }}
    nbthread {{ haproxy_tcp_lb_nbthread }}
    cpu-map {{ haproxy_tcp_lb_cpu_map }}

    # Security
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    option  log-health-checks

    timeout connect 5s
    timeout client  3600s
    timeout server  3600s
    timeout check   3s

    retries 3
    option  redispatch

    default-server inter 3s fall 3 rise 2

# Stats frontend
listen stats
    bind *:{{ haproxy_tcp_lb_stats_port }}
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s
    stats admin if LOCALHOST
    http-request use-service prometheus-exporter if { path /metrics }

# PostgreSQL Primary (Read/Write)
frontend pg_write
    bind *:{{ haproxy_tcp_lb_pg_write_port }}
    default_backend pg_primary

    # ACL for connection limiting
    acl too_many_conns fe_conn gt {{ haproxy_tcp_lb_pg_max_frontend_conns }}
    tcp-request connection reject if too_many_conns

backend pg_primary
    # Only the node with in_hot_standby = off (the primary) passes
{% set _u = haproxy_tcp_lb_pgsql_check_user %}
{% set _d = haproxy_tcp_lb_pg_check_database %}
    option tcp-check
    tcp-check connect
    tcp-check send-binary {{ '%08x' | format(_u | length + _d | length + 25) }}000300007573657200{{ _u.encode().hex() }}00646174616261736500{{ _d.encode().hex() }}00005800000004
    tcp-check expect binary 696e5f686f745f7374616e646279006f666600
{% for s in haproxy_tcp_lb_pg_primary_servers %}
    server {{ s.name }} {{ s.address }}:{{ s.port }} check{{ ' backup' if s.backup | default(false) else '' }}{{ '  # ' ~ s.comment if s.comment is defined else '' }}
{% endfor %}

# PostgreSQL Replicas (Read-Only)
frontend pg_read
    bind *:{{ haproxy_tcp_lb_pg_read_port }}
    default_backend pg_replicas

backend pg_replicas
    balance leastconn
    option pgsql-check user {{ haproxy_tcp_lb_pgsql_check_user }}
{% for s in haproxy_tcp_lb_pg_replica_servers %}
    server {{ s.name }} {{ s.address }}:{{ s.port }} check{{ ' backup' if s.backup | default(false) else '' }}{{ '  # ' ~ s.comment if s.comment is defined else '' }}
{% endfor %}

# Redis Cluster
frontend redis
    bind *:{{ haproxy_tcp_lb_redis_port }}
    default_backend redis_servers

backend redis_servers
    balance first
    option tcp-check
    tcp-check connect
    tcp-check send "PING\r\n"
    tcp-check expect string +PONG
    tcp-check send "INFO replication\r\n"
    tcp-check expect string role:master
    tcp-check send "QUIT\r\n"
    tcp-check expect string +OK
{% for s in haproxy_tcp_lb_redis_servers %}
    server {{ s.name }} {{ s.address }}:{{ s.port }} check
{% endfor %}
